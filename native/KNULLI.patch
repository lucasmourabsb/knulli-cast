+/// Disable radio power saving for the session and restore its previous state.
+struct WifiGuard(Option<String>);
+
+impl WifiGuard {
+    fn for_session() -> Self {
+        let Ok(interfaces) = std::fs::read_dir("/sys/class/net") else {return Self(None)};
+        for interface in interfaces.flatten() {
+            if !interface.path().join("wireless").exists()
+                && !interface.path().join("phy80211").exists() {continue;}
+            let name = interface.file_name().to_string_lossy().to_string();
+            let state = std::process::Command::new("iw")
+                .args(["dev", &name, "get", "power_save"]).output();
+            if let Ok(state) = state {
+                if String::from_utf8_lossy(&state.stdout).contains("Power save: on") {
+                    let changed = std::process::Command::new("iw")
+                        .args(["dev", &name, "set", "power_save", "off"]).output();
+                    if changed.is_ok_and(|result| result.status.success()) {return Self(Some(name));}
+                }
+            }
+        }
+        Self(None)
+    }
+}
+
+impl Drop for WifiGuard {
+    fn drop(&mut self) {
+        if let Some(name) = &self.0 {
+            let _ = std::process::Command::new("iw")
+                .args(["dev", name, "set", "power_save", "on"]).output();
+        }
+    }
+}
