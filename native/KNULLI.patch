+//! Handheld-side limits. Resolution and channel layout remain client-negotiated.
+use serde::Serialize;
+
+#[derive(Debug, Clone, Copy, Serialize)]
+pub struct StreamPreferences {
+    pub video_bitrate_max: u32,
+    pub video_fps_max: u32,
+    pub audio_bitrate_max: u32,
+    pub audio_capture_ms: u32,
+    pub audio_complexity: u32,
+}
+
+impl StreamPreferences {
+    pub fn from_env() -> Self {
+        Self::read(|key| std::env::var(key).ok())
+    }
+
+    fn read(get: impl Fn(&str) -> Option<String>) -> Self {
+        let number = |key, min, max, fallback| {
+            get(key).and_then(|s| s.parse::<u32>().ok())
+                .filter(|n| *n >= min && *n <= max).unwrap_or(fallback)
+        };
+        Self {
+            video_bitrate_max: number("RGSP_VIDEO_BITRATE_MAX", 750_000, 6_000_000, 3_000_000),
+            video_fps_max: number("RGSP_VIDEO_FPS_MAX", 1, 60, 60),
+            // Preserve the former encoder defaults when no UI preferences are passed.
+            audio_bitrate_max: number("RGSP_AUDIO_BITRATE_MAX", 64_000, 512_000, 512_000),
+            audio_capture_ms: number("RGSP_AUDIO_CAPTURE_MS", 5, 20, 5),
+            audio_complexity: number("RGSP_AUDIO_COMPLEXITY", 1, 5, 5),
+        }
+    }
+
+    pub fn effective_fps(&self, requested: u32) -> u32 {
+        requested.max(1).min(self.video_fps_max)
+    }
+
+    pub fn effective_video_bitrate(&self, requested: u32) -> u32 {
+        requested.max(100_000).min(self.video_bitrate_max)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn invalid_preferences_fall_back_to_working_limits() {
+        let prefs = StreamPreferences::read(|_| Some("0".into()));
+        assert_eq!(prefs.video_bitrate_max, 3_000_000);
+        assert_eq!(prefs.audio_capture_ms, 5);
+        assert_eq!(prefs.video_fps_max, 60);
+    }
+
+    #[test]
+    fn sender_limits_honor_lower_client_requests() {
+        let prefs = StreamPreferences::read(|key| match key {
+            "RGSP_VIDEO_BITRATE_MAX" => Some("1500000".into()),
+            "RGSP_VIDEO_FPS_MAX" => Some("30".into()),
+            _ => None,
+        });
+        assert_eq!(prefs.effective_video_bitrate(10_000_000), 1_500_000);
+        assert_eq!(prefs.effective_video_bitrate(1_000_000), 1_000_000);
+        assert_eq!(prefs.effective_fps(60), 30);
+        assert_eq!(prefs.effective_fps(25), 25);
+        assert_eq!(prefs.effective_fps(0), 1);
+    }
+}
